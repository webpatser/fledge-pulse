{
    "name": "webpatser/fledge-pulse",
    "description": "Fiber-native fork of Laravel Pulse for the Fledge framework: a real-time application performance monitoring tool and dashboard.",
    "keywords": [
        "laravel",
        "fledge",
        "pulse"
    ],
    "homepage": "https://github.com/webpatser/fledge-pulse",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/webpatser/fledge-pulse/issues",
        "source": "https://github.com/webpatser/fledge-pulse"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        },
        {
            "name": "Christoph Kempen",
            "email": "christoph@downsized.nl"
        }
    ],
    "require": {
        "php": "^8.5",
        "doctrine/sql-formatter": "^1.4.1",
        "guzzlehttp/promises": "^1.0|^2.0|^3.0",
        "laravel/sentinel": "^1.0",
        "league/uri": "^7.5.1",
        "livewire/livewire": "^4.0",
        "nesbot/carbon": "^2.67|^3.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "webpatser/fledge-fiber": "^13.22",
        "webpatser/fledge-framework": "^13.34"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.7|^8.0",
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1.33",
        "predis/predis": "^1.0|^2.0"
    },
    "replace": {
        "laravel/pulse": "self.version"
    },
    "conflict": {
        "nunomaduro/collision": "<7.7.0"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Pulse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\Pulse\\Tests\\Contract\\": "tests/Contract/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-fledge/1.x": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Laravel\\Pulse\\PulseServiceProvider",
                "Laravel\\Pulse\\Fiber\\FledgePulseServiceProvider"
            ],
            "aliases": {
                "Pulse": "Laravel\\Pulse\\Facades\\Pulse"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    }
}
