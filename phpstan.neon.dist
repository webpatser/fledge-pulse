includes:
  - ./phpstan-baseline.neon
parameters:
  paths:
    - src
    # Nothing in src uses the RemembersConcurrently trait (it is an opt-in
    # for cards), so PHPStan would skip it as unused; the test fixture card
    # gives it a class context to be analysed in.
    - tests/Fiber/Livewire/Fixtures/RemembersConcurrentlyCard.php
  excludePaths:
    - src/Facades/Pulse.php
  level: 8
  ignoreErrors:
    - identifier: function.alreadyNarrowedType
    - identifier: match.alwaysTrue
    - "#Class Laravel\\\\Telescope\\\\Contracts\\\\EntriesRepository not found#"
    - "#Call to static method store\\(\\) on an unknown class Laravel\\\\Telescope\\\\Telescope#"
  treatPhpDocTypesAsCertain: false
